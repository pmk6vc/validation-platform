FROM envoyproxy/envoy:v1.31-latest

# python3 is needed by the entrypoint to base64url-encode the JWT secret
RUN apt-get update && apt-get install -y --no-install-recommends python3 curl && rm -rf /var/lib/apt/lists/*

COPY deploy/envoy/envoy.yaml /etc/envoy/envoy.yaml
COPY deploy/envoy/docker-entrypoint.sh /docker-entrypoint.sh

EXPOSE 8082
ENTRYPOINT ["/docker-entrypoint.sh"]
