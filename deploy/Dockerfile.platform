# Build stage
FROM gradle:8.11-jdk21 AS build
WORKDIR /app
COPY --chown=gradle:gradle . .
RUN gradle :platform:buildFatJar --no-daemon

# Run stage
# Using -jre (Ubuntu/glibc), not -jre-alpine (musl). cloud-sql-jdbc-socket-factory
# pulls in netty-tcnative, whose native libs are built against glibc and SIGSEGV
# on musl at startup.
FROM eclipse-temurin:21-jre
RUN groupadd -r platform && useradd -r -g platform platform
WORKDIR /app
COPY --from=build /app/platform/build/libs/validation-platform.jar platform.jar
USER platform
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "platform.jar"]
