# Build stage
FROM gradle:8.11-jdk21 AS build
WORKDIR /app
COPY --chown=gradle:gradle . .
RUN gradle :collector:buildFatJar --no-daemon

# Run stage
FROM eclipse-temurin:21-jre-alpine
WORKDIR /app
COPY --from=build /app/collector/build/libs/collector.jar app.jar
EXPOSE 8081
ENTRYPOINT ["java", "-jar", "app.jar"]
