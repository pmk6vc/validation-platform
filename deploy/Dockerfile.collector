# Build stage
FROM gradle:8.11-jdk21 AS build
WORKDIR /app
COPY --chown=gradle:gradle . .
RUN gradle :collector:buildFatJar --no-daemon

# Run stage
# Using -jre (Ubuntu/glibc), not -jre-alpine (musl). cloud-sql-jdbc-socket-factory
# pulls in netty-tcnative, whose native libs are built against glibc and SIGSEGV
# on musl at startup.
FROM eclipse-temurin:21-jre
RUN groupadd -r collector && useradd -r -g collector collector
WORKDIR /app
COPY --from=build /app/collector/build/libs/collector.jar app.jar
USER collector
EXPOSE 8081
ENTRYPOINT ["java", "-jar", "app.jar"]
