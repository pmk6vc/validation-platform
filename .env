# Local Docker Compose configuration only.
# These are dummy credentials for the local development database container.
# They are NOT used in any deployed environment. Do not add real credentials here.
POSTGRES_DB=platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Port mappings (optional, defaults shown)
DB_PORT=5432
PROXY_PORT=8082

# JWT signing secret for Envoy auth.
# This is a dev-only dummy secret. Do not use in production.
JWT_SECRET=dev-secret-do-not-use-in-production
