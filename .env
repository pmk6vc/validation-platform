# Local Docker Compose configuration only.
# These are dummy credentials for the local development database container.
# They are NOT used in any deployed environment. Do not add real credentials here.
POSTGRES_DB=platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Port mappings (optional, defaults shown)
DB_PORT=5432
PROXY_PORT=8082

# RSA private key for JWT signing (PEM format, used by app's JWKS endpoint).
# Generate with: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 2>/dev/null | tr '\n' '|'
# Then paste the output here (pipes will be converted back to newlines by the app).
# This is a dev-only key. Do not use in production.
JWT_PRIVATE_KEY=
