root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true

[*.{kt,kts}]
ktlint_code_style = ktlint_official
max_line_length = 120

[*.{yaml,yml}]
indent_size = 2

[*.kts]
# Gradle properties use snake_case by convention
ktlint_standard_property-naming = disabled
